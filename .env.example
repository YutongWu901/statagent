# StatAgent configuration — copy to `.env` and fill in.
# All values are optional; without an API key the app runs in offline mode
# (rule-based planner + real statistical computation, no LLM).

# DeepSeek API key (also read from the standard DEEPSEEK_API_KEY variable)
STATAGENT_DEEPSEEK_API_KEY=sk-your-key-here

# OpenAI-compatible endpoint (defaults to DeepSeek)
STATAGENT_BASE_URL=https://api.deepseek.com

# Model id. deepseek-chat supports JSON output and function calling.
STATAGENT_MODEL=deepseek-chat

# Sampling / generation limits
STATAGENT_TEMPERATURE=0.0
STATAGENT_MAX_TOKENS=4096
STATAGENT_TIMEOUT=120

# Cost accounting, USD per million tokens (deepseek-chat list prices; adjust if pricing changes)
STATAGENT_PRICE_INPUT=0.27
STATAGENT_PRICE_OUTPUT=1.10

# Set to 0 to disable the offline fallback (app then requires an API key)
STATAGENT_OFFLINE_FALLBACK=1

# Reproducibility seed for bootstrap and synthetic data
STATAGENT_SEED=42
